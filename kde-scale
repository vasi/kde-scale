#!/usr/bin/env ruby
# KDE Plasma / Wayland display scaling. Only Ruby's standard library is needed.
require 'json'
require 'open3'
require 'optparse'

def parse_options(argv)
  options = { osd: true }
  values = []
  help = nil
  parser = OptionParser.new do |opts|
    opts.banner = 'Usage: kde-scale [options] [PERCENT|+PERCENT|-PERCENT]'
    opts.on('--output NAME', 'Select a display by name or ID') do |name|
      raise OptionParser::InvalidArgument, 'output must be a display name or ID' if name.empty? || name.start_with?('-')
      options[:output] = name
    end
    opts.on('--[no-]osd', 'Show Plasma OSD (default: enabled)') { |enabled| options[:osd] = enabled }
    opts.on('-h', '--help', 'Show this help') { puts help; exit }
    opts.separator <<~TEXT

      Examples:
        kde-scale 200    Set scaling to 200%
        kde-scale +10    Increase scaling by 10%
        kde-scale -5     Decrease scaling by 5%
    TEXT
  end
  # Generate help from user-facing options before adding the numeric parser rule.
  help = parser.to_s
  parser.on('-[0-9]PERCENT') { |value| values << "-#{value}" }
  parser.order!(argv) { |value| values << value }
  values.concat(argv) # Arguments after an explicit -- are positional too.
  raise OptionParser::InvalidArgument, 'specify just one scale or adjustment' if values.size > 1
  change = values.first
  if change && !change.match?(/\A[+-]?\d+(?:\.\d+)?%?\z/)
    raise OptionParser::InvalidArgument, "invalid scale or adjustment: #{change}"
  end
  options.merge(change: change&.delete_suffix('%'))
end

def executable(name)
  ENV.fetch('PATH', '').split(File::PATH_SEPARATOR).map { |dir| File.join(dir, name) }
     .find { |path| File.file?(path) && File.executable?(path) }
end

def capture(*command)
  stdout, stderr, status = Open3.capture3(*command)
  unless status.success?
    detail = [stderr.strip, stdout.strip].reject(&:empty?).join("\n")
    raise "#{File.basename(command.first)} failed#{detail.empty? ? '' : ": #{detail}"}"
  end
  stdout
end

def outputs(doctor)
  JSON.parse(capture(doctor, '-j')).fetch('outputs').select do |output|
    # KScreen omits 'enabled' for outputs that cannot be disabled.
    output['connected'] && output.fetch('enabled', true)
  end
end

def percent(scale)
  format('%.4f', scale * 100).sub(/\.?0+\z/, '') + '%'
end

def show_osd(qdbus, name, scale)
  raise 'qdbus was not found in PATH' unless qdbus

  capture(qdbus, 'org.kde.plasmashell', '/org/kde/osdService',
          'org.kde.osdService.showText', 'video-display', "#{name} · #{percent(scale)}")
rescue RuntimeError, SystemCallError => error
  # Feedback is best-effort: an OSD failure must not fail a successful change.
  warn "kde-scale: OSD unavailable: #{error.message} (use --no-osd to suppress)"
end

def active_display_name(displays, qdbus)
  name = nil
  begin
    name = capture(qdbus, 'org.kde.KWin', '/KWin', 'org.kde.KWin.activeOutputName').strip if qdbus
  rescue RuntimeError => error
    raise "#{error.message}\nUse --output NAME to select a display" unless displays.one?
  end
  name = displays.first.fetch('name') if displays.one? && (name.nil? || name.empty?)
  raise 'Cannot detect the active display; install qdbus6 or use --output NAME' if name.nil? || name.empty?
  name
end

def select_display(doctor, qdbus, target)
  displays = outputs(doctor)
  raise 'No connected, enabled displays found; run this inside your KDE session' if displays.empty?

  target ||= active_display_name(displays, qdbus)
  display = displays.find { |item| item['name'] == target || item['id'].to_s == target }
  raise "No enabled display matches #{target.inspect}; list them with kscreen-doctor -o" unless display
  display
end

def target_scale(current, change)
  amount = Float(change) / 100
  desired = (change.start_with?('+', '-') ? current + amount : amount).round(6)
  raise 'The resulting scale must be finite and greater than zero' unless desired.finite? && desired.positive?
  desired
end

def apply_scale(doctor, display, desired)
  id = Integer(display.fetch('id'))
  name = display.fetch('name')
  capture(doctor, "output.#{id}.scale.#{desired}")
  # Read the compositor's actual value, including any rounding it applies.
  updated = outputs(doctor).find { |item| item['name'] == name }
  raise "#{name} disappeared while applying the change" unless updated
  actual = Float(updated.fetch('scale'))
  if (actual - desired).abs > 0.01
    raise 'KDE did not apply the requested scale; check Display Configuration'
  end
  actual
end

def main(argv)
  options = parse_options(argv)
  if ENV['XDG_SESSION_TYPE'] == 'x11'
    raise 'Per-display fractional scaling requires a KDE Wayland session'
  end
  doctor = executable('kscreen-doctor') or raise 'kscreen-doctor was not found in PATH'
  qdbus = %w[qdbus6 qdbus-qt6 qdbus].filter_map { |name| executable(name) }.first
  display = select_display(doctor, qdbus, options[:output])
  current = Float(display.fetch('scale'))
  raise 'KScreen returned an invalid current scale' unless current.finite? && current.positive?

  unless options[:change]
    puts "#{display.fetch('name')}: #{percent(current)}"
    return
  end

  desired = target_scale(current, options[:change])
  actual = apply_scale(doctor, display, desired)
  show_osd(qdbus, display.fetch('name'), actual) if options[:osd]
end

begin
  main(ARGV)
rescue OptionParser::ParseError => error
  warn "kde-scale: #{error.message}\nRun kde-scale --help for usage"
  exit 1
rescue RuntimeError, SystemCallError, JSON::ParserError, KeyError, ArgumentError, TypeError => error
  warn "kde-scale: #{error.message}"
  exit 1
end
